PORT=4000
# Render injects PORT. Do not hardcode it in the Render dashboard.
# MongoDB Atlas URI is required. Render has no local MongoDB.
MONGODB_URI=mongodb://localhost:27017/lab
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated frontend origins, e.g. https://lab-web.onrender.com
CORS_ORIGIN=http://localhost:3000
